#!/usr/bin/env bash
# gym — render a scenario's guide.md as paged t/c/q panes, with Leitner
# spaced-repetition scheduling. Run in one tmux pane; run the scenario's
# ./run.sh in another. Ledger: .gym-ledger  (relpath  box  next_due  applied  streak5).
set -euo pipefail

clear

ROOT="$(cd "$(dirname "$0")" && pwd)"
LEDGER="$ROOT/.gym-ledger"
HISTORY="$ROOT/.gym-history"   # append-only: date  key  grade  old_box  new_box
TODAY=$(date +%F)
INTERVALS=(0 1 2 4 8 16)   # days by box (index 1..5)

b=$'\e[1m'; d=$'\e[2m'; c=$'\e[36m'; g=$'\e[32m'; y=$'\e[33m'; s=$'\e[34m'; it=$'\e[3m'; r=$'\e[0m'; clr=$'\e[2J\e[H'

usage(){
  cat <<'EOF'
Usage: ./gym [topic/scenario]

Without an argument, pick a ticket due today. In the guide:
  t  ticket    c  command hints    q  questions    a  your answers    x  finish and grade
  e  (on the answers page) write your answers in $VISUAL/$EDITOR, default vim

Opening non-empty answers caps the grade at struggle.

Run ./run.sh in another terminal to enter the disposable lab.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0;;
esac

# These are local runtime state, not repository fixtures. Creating them up
# front also makes the first run safe under `set -e`.
touch "$LEDGER" "$HISTORY"

# ── ledger helpers ─────────────────────────────────────────────────
led_field(){ awk -v k="$1" -v col="$2" '$1==k{val=$col; if((col==4 || col==5) && val=="") val=0; print val; exit}' "$LEDGER" 2>/dev/null; }
is_due(){ # key → due if unseen or next_due <= today
  local due; due=$(led_field "$1" 3); [[ -z "$due" || "$due" < "$TODAY" || "$due" == "$TODAY" ]]; }
led_set(){ # key box next_due [applied [streak5]]
  touch "$LEDGER"
  local tmp; tmp=$(mktemp)
  awk -v k="$1" '$1!=k' "$LEDGER" > "$tmp"
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-0}" "${5:-0}" >> "$tmp"
  mv "$tmp" "$LEDGER"
}
reschedule(){ # key grade
  local key=$1 grade=$2 box nb streak5 days due
  box=$(led_field "$key" 2); box=${box:-1}
  streak5=$(led_field "$key" 5); streak5=${streak5:-0}
  case "$grade" in
    pass)
      if (( box >= 5 )); then
        nb=5
        (( streak5 += 1 ))
      else
        nb=$(( box + 1 ))
        streak5=0
      fi
      ;;
    struggle)
      nb=$box
      (( box < 5 )) && streak5=0
      ;;
    fail)
      nb=1
      streak5=0
      ;;
  esac
  days=${INTERVALS[$nb]}
  (( nb == 5 )) && (( days += streak5 * 7 ))
  due=$(date -d "+${days} days" +%F)
  led_set "$key" "$nb" "$due" 0 "$streak5"
  printf '%s\t%s\t%s\t%s\t%s\n' "$TODAY" "$key" "$grade" "$box" "$nb" >> "$HISTORY"
  printf '%s✓ %s → box %s, next due %s%s\n' "$g" "$grade" "$nb" "$due" "$r"
}

# ── overdue drop penalty ───────────────────────────────────────────
DROPPED_COUNT=0
apply_overdue_penalties(){
  [[ -s "$LEDGER" ]] || return 0
  local sec_today tmp drops=()
  sec_today=$(date -u -d "$TODAY" +%s)
  tmp=$(mktemp)

  local key box next_due applied streak5
  while IFS=$'\t' read -r key box next_due applied streak5 || [[ -n "$key" ]]; do
    [[ -z "$key" ]] && continue
    key=${key%$'\r'}
    box=${box%$'\r'}
    next_due=${next_due%$'\r'}
    applied=${applied%$'\r'}
    streak5=${streak5%$'\r'}

    box=${box:-1}
    applied=${applied:-0}
    streak5=${streak5:-0}

    if [[ -n "$next_due" && "$next_due" < "$TODAY" ]]; then
      local sec_due
      if sec_due=$(date -u -d "$next_due" +%s 2>/dev/null); then
        local total_overdue delta new_box
        total_overdue=$(( (sec_today - sec_due) / 86400 ))
        delta=$(( total_overdue - applied ))
        if (( delta > 0 )); then
          new_box=$(( box - delta < 1 ? 1 : box - delta ))
          if (( new_box < box )); then
            (( box >= 5 && new_box < 5 )) && streak5=0
            drops+=("$key"$'\t'"$box"$'\t'"$new_box"$'\t'"$total_overdue")
            printf '%s\t%s\t%s\t%s\t%s\n' "$TODAY" "$key" "overdue_drop" "$box" "$new_box" >> "$HISTORY"
          fi
          box=$new_box
          applied=$total_overdue
        fi
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$box" "$next_due" "$applied" "$streak5" >> "$tmp"
  done < "$LEDGER"
  mv "$tmp" "$LEDGER"

  DROPPED_COUNT=${#drops[@]}
  (( DROPPED_COUNT )) || return 0

  printf '%sOverdue Level Drops%s\n\n' "$b" "$r"
  local width=0 item k ob nb od
  for item in "${drops[@]}"; do
    IFS=$'\t' read -r k ob nb od <<< "$item"
    ((${#k} > width)) && width=${#k}
  done
  for item in "${drops[@]}"; do
    IFS=$'\t' read -r k ob nb od <<< "$item"
    local s_od="days"
    (( od == 1 )) && s_od="day"
    printf '  %-*s      %sbox %s → %s%s %s(%d %s overdue)%s\n' "$width" "$k" "$y" "$ob" "$nb" "$r" "$d" "$od" "$s_od" "$r"
  done
  printf '\n'
}

# ── pick a due scenario ────────────────────────────────────────────
pick_scenario(){
  mapfile -t all < <(cd "$ROOT" && find . -name guide.md | sort)
  ((${#all[@]})) || { echo "no guide.md found under $ROOT"; exit 1; }
  due=()
  for gm in "${all[@]}"; do
    local key; key=$(dirname "${gm#./}")
    is_due "$key" && due+=("$gm")
  done
  ((${#due[@]})) || { printf '%sNothing due today. \U0001F389%s\n' "$g" "$r"; exit 0; }
  printf '%sToday'\''s Tickets%s\n\n' "$b" "$r"
  local i=1 width=0
  for gm in "${due[@]}"; do
    local key; key=$(dirname "${gm#./}")
    ((${#key} > width)) && width=${#key}
  done
  for gm in "${due[@]}"; do
    local key box next_box next_days streak5; key=$(dirname "${gm#./}"); box=$(led_field "$key" 2); box=${box:-1}
    if (( box >= 5 )); then
      streak5=$(led_field "$key" 5); streak5=${streak5:-0}
      next_days=$(( INTERVALS[5] + (streak5 + 1) * 7 ))
    else
      next_box=$(( box + 1 )); next_days=${INTERVALS[$next_box]}
    fi
    printf '  %s%d%s  %-*s      %s%sAgain in %s days%s\n' "$c" "$i" "$r" "$width" "$key" "$s" "$it" "$next_days" "$r"; ((i+=1))
  done
  printf '\nPick (q to quit): '; read -r n
  [[ "$n" == q ]] && return 1
  [[ "$n" =~ ^[0-9]+$ ]] && (( n>=1 && n<=${#due[@]} )) || { echo "bad pick"; exit 1; }
  GUIDE="$ROOT/${due[$((n-1))]#./}"
}

pick_requested_guide(){
  key=${1%/}; key=${key#pool/}
  GUIDE="$ROOT/pool/$key/guide.md"
  [[ -f "$GUIDE" ]] || { echo "ticket not found: $1"; exit 1; }
}

# ── parse guide.md ─────────────────────────────────────────────────
load_guide(){
  KEY=$(dirname "${GUIDE#$ROOT/}")
  TITLE=$(awk 'NR==1{sub(/^# /,""); print; exit}' "$GUIDE")
  TICKET=$(section TICKET)
  COMMANDS=$(section COMMANDS | tr -s ' \n' ' ' | sed 's/^ *//;s/ *$//')
  QUESTIONS=$(section QUESTIONS)
  ANSWERS=$(section ANSWERS)
  PEEKED=0
}
section(){ awk -v s="## $1" '$0==s{f=1;next} /^## /{f=0} f' "$GUIDE"; }

# ── paged render loop ──────────────────────────────────────────────
nav(){
  local a=$1; hl(){ [ "$1" = "$a" ] && printf '%s%s%s' "$c$b" "$2" "$r" || printf '%s%s%s' "$d" "$2" "$r"; }
  printf '\n%s ─ %s' "$d" "$r"
  hl t '[t]icket'; printf '   '; hl c '[c]ommands'; printf '   '; hl q '[q]uestions'; printf '   '; hl a '[a]nswers'
  [ "$a" = a ] && printf '   %s[e]dit%s' "$c$b" "$r"
  printf '   %s[x]done%s\n' "$d" "$r"
}
page_ticket(){ printf '%s%sTICKET: %s%s\n\n%s\n' "$clr" "$b" "$TITLE" "$r" "$TICKET"; nav t; }
page_commands(){ printf '%s%sCOMMANDS IN PLAY%s\n\n  %s%s%s\n' "$clr" "$b" "$r" "$g" "$COMMANDS" "$r"; nav c; }
page_questions(){ printf '%s%sQUESTIONS%s\n\n%s\n' "$clr" "$b" "$r" "$QUESTIONS"; nav q; }
page_answers(){
  if [[ -z "${ANSWERS//[[:space:]]/}" ]]; then
    printf '%s%sYOUR ANSWERS%s\n\n%sNone yet. Press e to write your hints.%s\n' "$clr" "$b" "$r" "$d" "$r"
  else
    printf '%s%sYOUR ANSWERS%s  %s(grade capped at struggle)%s\n\n%s\n' "$clr" "$b" "$r" "$y" "$r" "$ANSWERS"
  fi
  nav a
}
# Peeking at the answers means the theory was not recalled: confirm first,
# because the peek is recorded and blocks a pass grade.
confirm_answers(){
  [[ -z "${ANSWERS//[[:space:]]/}" || $PEEKED == 1 ]] && return 0
  printf '%s%sOpen your answers?%s This caps the grade at struggle. [y/N] ' "$clr" "$b" "$r"
  local k; read -rsn1 k
  [[ "$k" == y ]] && PEEKED=1
}
# Open the guide in the editor at its last line (the ANSWERS section is last),
# then reload only the answers so the peek state survives.
edit_answers(){
  local lines; lines=$(wc -l < "$GUIDE")
  ${VISUAL:-${EDITOR:-vim}} "+$lines" "$GUIDE" < /dev/tty > /dev/tty
  ANSWERS=$(section ANSWERS)
}

# Preview the same Leitner transitions used by reschedule, without writing state.
preview_schedule(){
  local grade=$1 box nb streak5 days
  box=$(led_field "$KEY" 2); box=${box:-1}
  streak5=$(led_field "$KEY" 5); streak5=${streak5:-0}
  case "$grade" in
    pass)
      if (( box >= 5 )); then
        nb=5
        (( streak5 += 1 ))
      else
        nb=$(( box + 1 ))
        streak5=0
      fi ;;
    struggle)
      nb=$box
      (( box < 5 )) && streak5=0 ;;
    fail)
      nb=1
      streak5=0 ;;
  esac
  days=${INTERVALS[$nb]}
  (( nb == 5 )) && (( days += streak5 * 7 ))
  printf '%s' "$days"
}

grade_prompt(){
  printf '%s%sGrade this ticket%s  %s(weakest of practical + theory)%s\n\n' "$clr" "$b" "$r" "$d" "$r"
  if ((PEEKED)); then
    printf '  %s[p]ass%s      unavailable (answers opened)\n' "$d" "$r"
  else
    printf '  %s[p]ass%s      in %s days\n' "$g" "$r" "$(preview_schedule pass)"
  fi
  printf '  %s[s]truggle%s  in %s days\n' "$y" "$r" "$(preview_schedule struggle)"
  printf '  %s[f]ail%s      in %s days\n\n' "$c" "$r" "$(preview_schedule fail)"
  local k; read -rsn1 k
  case "$k" in
    p) if ((PEEKED)); then printf '%sanswers were opened: recorded as struggle%s\n' "$y" "$r"; reschedule "$KEY" struggle
       else reschedule "$KEY" pass; fi;;
    s) reschedule "$KEY" struggle;;
    f) reschedule "$KEY" fail;;
    *) printf '%sno grade recorded%s\n' "$d" "$r";;
  esac
}

run_guide(){
  load_guide
  clear  # Remove the ticket picker before showing the selected ticket.
  # run.sh reads this last-served ticket to decide whether slow-box jobs start.
  printf '%s\n' "${KEY#pool/}" > "$ROOT/.gym-active"
  local view=t k
  while :; do
    case "$view" in t) page_ticket;; c) page_commands;; q) page_questions;; a) page_answers;; esac
    read -rsn1 k
    case "$k" in t|c|q) view=$k;; a) confirm_answers && [[ -z "${ANSWERS//[[:space:]]/}" || $PEEKED == 1 ]] && view=a;; e) [[ "$view" == a ]] && edit_answers;; x) grade_prompt; break;; esac
  done
}

apply_overdue_penalties

if (($#)); then
  pick_requested_guide "$1"
  if (( DROPPED_COUNT > 0 )); then
    printf '%sPress any key to open guide (or q to quit)...%s' "$d" "$r"
    read -rsn1 k
    [[ "$k" == q ]] && exit 0
  fi
  run_guide
else
  while pick_scenario; do
    run_guide
  done
fi

